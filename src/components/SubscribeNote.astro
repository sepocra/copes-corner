---
import { SUBSCRIBE_URL } from '../consts';
---

<p class="subscribe-note">
  A short note every second Sunday.
  <a href={SUBSCRIBE_URL} target="_blank" rel="noopener noreferrer">Subscribe</a>.
</p>

<style>
  .subscribe-note {
    margin: 2.5rem 0 0;
    font-family: 'Source Serif 4', Georgia, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #666;
  }

  .subscribe-note a {
    font-style: normal;
    font-weight: 400;
    color: #6b7645;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;
  }

  .subscribe-note a:hover,
  .subscribe-note a:focus-visible {
    color: #515a33;
  }

  @media (prefers-color-scheme: dark) {
    .subscribe-note {
      color: #c8c0b0;
    }

    .subscribe-note a {
      color: #7a9e68;
    }

    .subscribe-note a:hover,
    .subscribe-note a:focus-visible {
      color: #96b885;
    }
  }
</style>
